{
  "name": "game",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/client"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @game/client",
    "build": "npm run build -w @game/client",
    "preview": "npm run preview -w @game/client",
    "art": "npm run art -w @game/client",
    "typecheck": "npm run art && tsc -p packages/shared && tsc -p packages/client && tsc -p packages/client/art",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

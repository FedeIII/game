{
  "name": "game",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "worlds/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @game/app",
    "build": "npm run build -w @game/app",
    "preview": "npm run preview -w @game/app",
    "art": "npm run art -w @game/engine-client",
    "typecheck": "npm run art && tsc -p packages/engine && tsc -p packages/engine-client && tsc -p packages/engine-client/art && tsc -p worlds/wilds && tsc -p worlds/town && tsc -p apps/game",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
